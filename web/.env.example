# Default Ollama base URL used server-side when the Settings panel hasn't
# overridden it yet. Because the cloudflared tunnel URL rotates on restart,
# you'll usually just edit this from the in-app Settings panel instead —
# this env var only matters for the very first load / fresh deploys.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag to call by default.
OLLAMA_MODEL=imagination-2.1-pro-lmh

# Optional bearer token, only needed if your tunnel/endpoint requires auth.
# Leave blank for local Ollama with no auth.
OLLAMA_AUTH_TOKEN=

# Optional workspace root for built-in file/command tools. Defaults to the
# parent directory of `web/`, which matches this repository layout.
IMAGINATION_WORKSPACE_ROOT=

# Optional persistent storage root for generated files and the command sandbox.
# Defaults to ~/.imagination-ui (or %USERPROFILE%\.imagination-ui on Windows).
IMAGINATION_TOOL_STORAGE_ROOT=
